
### ===== Auth =====

### 1. Register: creates the user and returns a token pair
< {%
    client.global.set("email", "api-test-" + Date.now() + "@example.com");
%}
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "secret123"
}

> {%
    client.test("register: 201 and a token pair", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.body.access_token, "no access_token");
        client.assert(response.body.refresh_token, "no refresh_token");
    });
%}


### 2. Register the same email again (in another case) -> 409
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "secret123"
}

> {%
    client.test("register twice: 409", () => {
        client.assert(response.status === 409, "status " + response.status);
    });
%}


### 3. Login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "secret123"
}

> {%
    client.test("login: 200 and a token pair", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.access_token, "no access_token");
    });
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}


### 4. Login with a wrong password -> 401
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

> {%
    client.test("wrong password: 401", () => {
        client.assert(response.status === 401, "status " + response.status);
    });
%}


### 5. Current user: no body, access token in the header
GET {{host}}/users/me
Authorization: Bearer {{access_token}}

> {%
    client.test("me: 200 and the same email", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.email === client.global.get("email"), "email " + response.body.email);
        client.assert(response.body.password_hash === undefined, "password hash must not be returned");
        client.assert(response.body.role === "CUSTOMER", "role " + response.body.role);
    });
    client.global.set("user_id", response.body.id);
%}


### 6. Current user without a token -> 401
GET {{host}}/users/me

> {%
    client.test("me without token: 401", () => {
        client.assert(response.status === 401, "status " + response.status);
    });
%}


### 7. New access + refresh pair by refresh token (the old refresh token stops working)
POST {{host}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

> {%
    // read before set: client.test callbacks run after the whole script, when the variable is already new
    const previous = client.global.get("refresh_token");
    client.test("refresh: 200 and a new pair", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.refresh_token !== previous, "refresh token not changed");
    });
    client.global.set("old_refresh_token", previous);
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
%}


### 8. The old refresh token can't be used twice -> 401
POST {{host}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{old_refresh_token}}"
}

> {%
    client.test("used refresh token: 401", () => {
        client.assert(response.status === 401, "status " + response.status);
    });
%}


