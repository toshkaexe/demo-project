### 16. Products: list all, sorted by id
GET {{host}}/products

> {%
    client.test("list products: 200 and contains the new product", () => {
        client.assert(response.status === 200, "status " + response.status);
        const ids = response.body.map(p => p.id);
        client.assert(ids.includes(client.global.get("product_id")), "product not in the list");
        client.assert(ids.every((id, i) => i === 0 || ids[i - 1] < id), "not sorted by id");
    });
%}


