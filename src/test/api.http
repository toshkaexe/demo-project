### 38. Orders: CANCELLED is final -> 409
PATCH {{host}}/orders/{{order_id}}/status
Authorization: Bearer {{warehouse_token}}
Content-Type: application/json

{
  "status": "PROCESSING"
}

> {%
    client.test("change after CANCELLED: 409", () => {
        client.assert(response.status === 409, "status " + response.status);
    });
%}


### 39. Orders: status history, oldest first
GET {{host}}/orders/{{order_id}}/history
Authorization: Bearer {{access_token}}

> {%
    client.test("history: CREATED -> PROCESSING -> CANCELLED", () => {
        client.assert(response.status === 200, "status " + response.status);
        const steps = response.body.map(h => (h.from_status || "null") + "->" + h.to_status);
        client.assert(steps.join(", ") === "null->CREATED, CREATED->PROCESSING, PROCESSING->CANCELLED",
            "history " + steps.join(", "));
        client.assert(response.body[1].changed_by === client.global.get("warehouse_id"), "PROCESSING by " + response.body[1].changed_by);
        client.assert(response.body[2].changed_by === client.global.get("user_id"), "CANCELLED by " + response.body[2].changed_by);
    });
%}


