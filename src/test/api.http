### 13. Products: create -> 201 + Location: /products/{id}
POST {{host}}/products
Authorization: Bearer {{warehouse_token}}
Content-Type: application/json

{
  "name": "Milk 3.2%",
  "quantity": 10,
  "price": 89.90
}

> {%
    client.test("create product: 201, Location and the product", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/products/" + response.body.id),
            "Location " + response.headers.valueOf("Location"));
        client.assert(response.body.name === "Milk 3.2%", "name " + response.body.name);
        client.assert(response.body.quantity === 10, "quantity " + response.body.quantity);
        client.assert(response.body.price === 89.9, "price " + response.body.price);
    });
    client.global.set("product_id", response.body.id);
%}


