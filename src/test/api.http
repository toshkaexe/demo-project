### 23. Orders: without a token -> 401
POST {{host}}/orders
Content-Type: application/json

{
  "items": [{ "product_id": {{product_id}}, "quantity": 1 }]
}

> {%
    client.test("order without token: 401", () => {
        client.assert(response.status === 401, "status " + response.status);
    });
%}


### 24. Orders: create -> 201 + Location: /orders/{id}, the items are taken from stock
POST {{host}}/orders
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "items": [
    { "product_id": {{product_id}}, "quantity": 2 },
    { "product_id": {{product2_id}}, "quantity": 1 }
  ]
}

> {%
    client.test("create order: 201, items with prices and total", () => {
        client.assert(response.status === 201, "status " + response.status);
        client.assert(response.headers.valueOf("Location").endsWith("/orders/" + response.body.id),
            "Location " + response.headers.valueOf("Location"));
        client.assert(response.body.status === "CREATED", "status " + response.body.status);
        client.assert(response.body.user_id === client.global.get("user_id"), "user_id " + response.body.user_id);
        client.assert(response.body.items.length === 2, "items " + response.body.items.length);
        client.assert(response.body.items[0].price === 79.9, "price " + response.body.items[0].price);
        client.assert(response.body.items[0].amount === 159.8, "amount " + response.body.items[0].amount);
        client.assert(response.body.total === 204.8, "total " + response.body.total);
        client.assert(response.body.completed_at == null, "completed_at " + response.body.completed_at);
    });
    client.global.set("order_id", response.body.id);
%}


